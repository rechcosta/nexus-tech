rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // ! Manter sincronizado com app_constants.dart e firestore.rules.
    // Hoje nenhuma regra de Storage depende do papel — anexos são autorizados
    // pela posse da demanda no Firestore e pelo `enviadoPorUid` no metadata.
    // A função fica documentada aqui para o dia em que isso mudar.
    function isProfessorEmail() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*@osorio[.]ifrs[.]edu[.]br')
        // ===== INÍCIO — E-MAIL DE TESTE (PROFESSOR) — REMOVER ANTES DE PRODUÇÃO =====
        || request.auth.token.email in ['gustavinho.rechcosta@gmail.com']
        // ===== FIM — E-MAIL DE TESTE (PROFESSOR) =====
      );
    }

    // ============== FOTO DE PERFIL ==============
    match /users/{uid}/{arquivo} {
      allow read: if isSignedIn();

      allow write: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ============== ANEXOS DE DEMANDAS ==============
    match /demandas/{demandaId}/anexos/{arquivo} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/jpeg',
          'image/png'
        ];

      allow update: if false;

      allow delete: if isSignedIn() &&
        request.auth.uid == resource.metadata.enviadoPorUid;
    }

    // ============== BLOQUEIO PADRÃO ==============
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}